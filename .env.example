# Copy this to .env.local and fill in values
VITE_API_URL=http://127.0.0.1:8000/api
VITE_META_PIXEL_ID=your_pixel_id_here
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# Feature flags — build-time fallback if /api/core/features/ is unreachable.
# Set to "true" to force-enable locally. Prod should rely on the backend flag.
VITE_FEATURE_COMMUNITY_ENABLED=false
